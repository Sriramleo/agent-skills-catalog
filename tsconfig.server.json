{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": [
    "src/core/**/*",
    "src/server/**/*",
    "src/cli/**/*",
    "src/index.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/client/**/*",
    "**/*.test.ts"
  ]
}
